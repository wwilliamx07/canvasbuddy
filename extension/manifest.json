{
  "manifest_version": 3,
  "name": "CanvasBuddy",
  "version": "0.0.0",
  "description": "AI study assistant for Canvas",
  "action": {
    "default_title": "Open CanvasBuddy",
    "default_icon": {
      "16": "logo128.png",
      "48": "logo128.png",
      "128": "logo128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "logo128.png",
    "48": "logo128.png",
    "128": "logo128.png"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://*.utoronto.ca/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
